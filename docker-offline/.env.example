# start.sh generates .env with random credentials if absent. Set PUBLIC_HOST for the target server.
PROJECT_NAME=remote-meeting-offline
BACKEND_IMAGE=remote-meeting-stack-backend:local
ADMIN_WEB_IMAGE=remote-meeting-stack-admin-web:local
PUBLIC_HOST=127.0.0.1
PUBLIC_SCHEME=http
LIVEKIT_PUBLIC_SCHEME=ws

POSTGRES_DB=remote_meeting
POSTGRES_USER=remote_meeting
POSTGRES_PASSWORD=replace-with-a-random-password

REDIS_PASSWORD=replace-with-a-random-password

LIVEKIT_API_KEY=replace-with-a-random-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT_START=50000
LIVEKIT_RTC_UDP_PORT_END=50100
RECORDING_AUTO_ENABLED=true
RECORDING_RETENTION_DAYS=7

BACKEND_PORT=8080
ADMIN_WEB_PORT=8088
JWT_SECRET=replace-with-at-least-32-random-characters

ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=replace-with-a-random-password
ADMIN_BOOTSTRAP_ENABLED=true
DEMO_DATA_ENABLED=false
